/// Aura, how recognizable a character is to all of the others
#define ATTRIBUTE_AURA "aura"
/// Smarts, a measure of either learned book knowledge
#define ATTRIBUTE_SMARTS "smarts"
/// Intuition, a measure of how you can either apply smarts practically, or figure something out
#define ATTRIBUTE_INTUITION "intuition"
/// Muscle, simply your raw physical strength
#define ATTRIBUTE_MUSCLE "muscle"
/// Reflex, covers most things "dexterity" might
#define ATTRIBUTE_REFLEX "reflex"
/// Awareness, how able you are to notice small details in your environment
#define ATTRIBUTE_AWARENESS "awareness"

/// The maximum value an attribute can be
#define MAX_ATTRIBUTE_SCORE 10
/// The default value of an attribute
#define DEFAULT_ATTRIBUTE_SCORE 5

/// The maximum value that a skill can hold
#define MAX_SKILL_LEVEL 15

// All skills that a mob can have are defined below
/// Skill at using non-weapon items as a weapon
#define SKILL_WEAPON_ECCENTRIC "weapons_eccentric"
